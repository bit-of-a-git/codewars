from typing import List

"""
This is very similar to a HackerRank question.
"""


class Solution:
    def vowelStrings(self, words: List[str], queries: List[List[int]]) -> List[int]:
        vowels = set("aeiou")
        # We initialise a prefix sum array to keep track of the vowel count
        # as we iterate through the arr, with an extra 0 at the start to
        # avoid the special case of ind 0
        prefix_arr = [0] * (len(words) + 1)

        def starts_ends_with_vowel(s: str) -> bool:
            return s[0] in vowels and s[-1] in vowels

        for i, w in enumerate(words):
            prefix_arr[i + 1] = prefix_arr[i] + int(starts_ends_with_vowel(w))

        result = []
        for left, right in queries:
            result.append(prefix_arr[right + 1] - prefix_arr[left])
        return result
